				</style>
				<text_box font_weight="bold" text_align="center" vertical_text_align="center" font_size="24pt" appearance="transparent" x="50.9007" y="8.25" width="455.154" height="48">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p align=&quot;justify&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:24pt; font-weight:700; color:#ffffff;&quot;&gt;Systems Thinking Activity&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box border_color="blue" border_width="2" x="52.5742" y="75.437" width="466.711" height="517">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#000000;&quot;&gt;This&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#090909;&quot;&gt; is a short exercise to explore the comparative effectiveness of the three main intervention domains in our systems dynamics (SD) model. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; color:#090909;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#090909;&quot;&gt;The three main intervention domains in our model are &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-weight:700; color:#00b0f0;&quot;&gt;COMMUNITY&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#00b0f0;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-weight:700; color:#00b0f0;&quot;&gt;OUTREACH&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#030709;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#00b0f0;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-weight:700; color:#00b0f0;&quot;&gt;PrEP&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#00b0f0;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-weight:700; color:#00b0f0;&quot;&gt;INITIATION&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#030608;&quot;&gt;, and&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#00b0f0;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-weight:700; color:#00b0f0;&quot;&gt;PrEP&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#00b0f0;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-weight:700; color:#00b0f0;&quot;&gt;RETENTION&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#00b0f0;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; color:#090909;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; color:#090909;&quot;&gt;We can use our SD model to compare &apos;What if&apos; scenarios: &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; color:#090909;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt;      • &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;What if we make no new changes? (Base &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;        case scenario)&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Segoe UI&apos;; font-size:9pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt;      • &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;What if we improve &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; font-weight:700; color:#00b0f0;&quot;&gt;COMMUNITY     &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; font-weight:700; color:#00b0f0;&quot;&gt;         OUTREACH?&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Segoe UI&apos;; font-size:9pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt;      • &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;What if we improve &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; font-weight:700; color:#00b0f0;&quot;&gt;PrEP INITIATION?&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Segoe UI&apos;; font-size:9pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt;      • &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;What if we improve &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; font-weight:700; color:#00b0f0;&quot;&gt;PrEP&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; font-weight:700; color:#00b0f0;&quot;&gt;RETENTION&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;?&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Segoe UI&apos;; font-size:9pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt;      • &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;What is the most impactful mix of these     &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;         interventions, in the short-run? &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Segoe UI&apos;; font-size:9pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt;      • &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;What&apos;s most acceptable, easiest to &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;         implement, best fit? [stakeholder buy-in]&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<graphics_frame fill="none" x="553.901" y="39.011" width="655.31" height="295.824">
					<image width="286" height="176" size_to_parent="false" isee:transparency="0" isee:fixed_aspect_ratio="true">data:image/png;base64,</image>
				</graphics_frame>
				<graphics_frame fill="none" x="482.857" y="297.857" width="407.857" height="234.286">
					<image width="288" height="175" size_to_parent="false" isee:transparency="0" isee:fixed_aspect_ratio="true">data:image/png;base64,</image>
				</graphics_frame>
			</view>
			<view isee:template_view="template:4" background="white" page_width="1066" page_height="600" isee:scroll_x="71.7647" isee:scroll_y="114.118" zoom="85" type="interface">
				<style>
					<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				</style>
				<text_box appearance="transparent" x="31.1456" y="78.5169" width="506.318" height="175.23">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:13pt; font-weight:700; color:#000102;&quot;&gt;Scenario&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:13pt; font-weight:700; color:#080808;&quot;&gt; 1: Base Case (S1)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:11pt; color:#080808;&quot;&gt;The base case scenario reflects PrEP reach if we make no new changes to existing interventions in the Bronx. Before adjusting any of the model’s intervention effects (intervention sliders), click &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:11pt; font-weight:700; color:#0c31ef;&quot;&gt;Restore &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:11pt; color:#080808;&quot;&gt;to clear prior simulation runs. Now simulate the base case scenario by clicking &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:11pt; font-weight:700; color:#0c31ef;&quot;&gt;Run&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:11pt; color:#080808;&quot;&gt; below. This will allow you to compare results to the original scenario of no new changes. &lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:11pt;&quot;&gt;Use the &lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:11pt; font-weight:700; color:#0c31ef;&quot;&gt;drop down box&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:11pt; color:#0c31ef;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:11pt;&quot;&gt;in the figure to the right to see results for different variables. When ready, click &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:11pt; font-weight:700; color:#0c31ef;&quot;&gt;Next Page&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:11pt;&quot;&gt;. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<isee:annotation background="#CEF0FF" popup_background_color="#DEF5FF" highlight_on_open="true" popup_font_weight="bold" popup_font_color="white" launcher_label="?" show_by_default="false" hide_launcher="false" launch_on_hover="true" x="355.263" y="255.239" width="29.7367" height="25.3846">
					<popup x="144.207" y="154.803" width="224.929" height="134.615">
						<text>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
