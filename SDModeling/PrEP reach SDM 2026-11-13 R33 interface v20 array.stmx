&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:24pt; font-weight:700; color:#000000;&quot;&gt;Welcome to the Bronx PrEP reach system dynamics modeling interface&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<graphics_frame fill="none" x="185" y="333.571" width="100" height="100">
					<image width="0" height="0" size_to_parent="false" isee:transparency="0" isee:fixed_aspect_ratio="true"/>
				</graphics_frame>
				<graphics_frame fill="none" x="47.033" y="250" width="290.714" height="267.143">
