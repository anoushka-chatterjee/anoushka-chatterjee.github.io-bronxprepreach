			<view isee:template_view="template:2" background="white" page_width="1066" page_height="600" zoom="85" type="interface">
				<style>
					<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				</style>
				<text_box border_color="blue" border_width="2" x="36.3235" y="86.5735" width="443.5" height="547.75">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;We are using system dynamics modeling as a collaborative, evidence-informed approach to guide community decision-making about HIV prevention in the Bronx. Through system dynamics group model building (SD GMB), we work with stakeholders to map and understand the complex, interconnected factors that influence access to and uptake of PrEP among people at risk of HIV. This process allows us to build and validate a shared model of how structural, social, and behavioral dynamics shape PrEP reach over time. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;We then use the model as a virtual testing environment to identify and compare potential interventions, helping the community prioritize strategies that are most likely to have high impact. By simulating outcomes before investing in real-world implementation, this approach ensures that our limited research resources are used strategically to support effective, community-informed interventions that can reduce new HIV infections.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box font_weight="bold" text_align="center" vertical_text_align="center" font_size="24pt" appearance="transparent" x="37.3235" y="8" width="399" height="48">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p align=&quot;justify&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:24pt; font-weight:700; color:#f6f6f6;&quot;&gt;Our&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:24pt; font-weight:700;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:24pt; font-weight:700; color:#fdfdfd;&quot;&gt;A&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:24pt; font-weight:700; color:#ffffff;&quot;&gt;pproach&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<graphics_frame fill="none" x="465" y="76.4643" width="537.143" height="469.286">
					<image width="607" height="431" size_to_parent="false" isee:transparency="0" isee:fixed_aspect_ratio="true">data:image/png;base64,</image>
				</graphics_frame>
			</view>
			<view isee:template_view="template:2" background="white" page_width="1066" page_height="600" zoom="115" type="interface">
				<style>
					<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				</style>
				<text_box z_index="2" x="798.654" y="97.5865" width="230.5" height="263">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; font-weight:700; color:#000000;&quot;&gt;Our&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; font-weight:700;&quot;&gt; hypothesized theory of change! &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;These four feedback loops that define our Causal Loop Diagram (CLD) explain the dynamics of PrEP reach, representing the &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; text-decoration: underline; color:#36bc36;&quot;&gt;PrEP continuum&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;, key &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; text-decoration: underline; color:#cc5eff;&quot;&gt;psychosocial drivers&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;, and the effects of enhanced interventions, over time. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:14pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box font_weight="bold" text_align="center" vertical_text_align="center" font_size="24pt" appearance="transparent" x="-9.35444" y="10.272" width="425" height="47">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:24pt; font-weight:700; color:#ffffff;&quot;&gt;Causal Loop Diagram &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<graphics_frame fill="none" x="11.25" y="36.25" width="778.654" height="556.25">
