&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#020202;&quot;&gt;Scenario&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#000000;&quot;&gt; Analyses: Build your own intervention strategy&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; color:#020202;&quot;&gt;Define your own intervention strategy. Change one or more intervention domains to any effect size of your liking (0 to 10) and click &lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#0c31ef;&quot;&gt;Run&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; color:#020202;&quot;&gt;. Now compare results across scenarios using the results in this figure and in the &lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#0c31ef;&quot;&gt;Reach&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; color:#000000;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#0c31ef;&quot;&gt; Knowledge &lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; color:#000000;&quot;&gt;and&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#0c31ef;&quot;&gt; Trust &lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; color:#000000;&quot;&gt;Dashboards.&lt;/span&gt;&lt;span style=&quot; font-family:&apos;.AppleSystemUIFont&apos;; font-size:13pt; font-weight:700; color:#0c31ef;&quot;&gt; &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<isee:annotation background="#CEF0FF" popup_background_color="#DEF5FF" highlight_on_open="true" popup_font_weight="bold" popup_font_color="white" launcher_label="?" show_by_default="false" hide_launcher="false" launch_on_hover="true" x="342.186" y="245.077" width="29.7367" height="25.3846">
					<popup x="146.399" y="99.4066" width="224.929" height="134.615">
						<text>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
