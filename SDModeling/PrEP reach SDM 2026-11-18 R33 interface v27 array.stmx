				</element>
				<element subscript="Bronx">
					<eqn>(Effect_of_misinformation_on_PrEP_community_know+Effect_of_experiential_learning_on_PrEP_community_know)/2</eqn>
				</element>
				<units>Knowledge units</units>
			</aux>
			<aux name="Expected level of misinformation">
				<dimensions>
					<dim name="BxPrEPsubpops"/>
				</dimensions>
				<element subscript="Cisgender_women">
					<eqn>Effect_of_PrEP_stigma_on_PrEP_misinformation</eqn>
				</element>
				<element subscript="Trans_women">
					<eqn>Effect_of_PrEP_stigma_on_PrEP_misinformation</eqn>
				</element>
				<element subscript="MSM">
					<eqn>Effect_of_PrEP_stigma_on_PrEP_misinformation</eqn>
				</element>
				<element subscript="Bronx">
					<eqn>Effect_of_PrEP_stigma_on_PrEP_misinformation</eqn>
				</element>
				<units>Misinformation units</units>
			</aux>
			<stock name="Stigma associated\nwith PrEP users">
				<dimensions>
					<dim name="BxPrEPsubpops"/>
				</dimensions>
				<element subscript="Cisgender_women">
					<eqn>50</eqn>
				</element>
				<element subscript="Trans_women">
					<eqn>50</eqn>
				</element>
				<element subscript="MSM">
					<eqn>50</eqn>
				</element>
				<element subscript="Bronx">
					<eqn>50</eqn>
				</element>
				<inflow>Change_in_PrEP_stigma</inflow>
				<non_negative/>
				<units>Stigma units</units>
			</stock>
			<flow name="Change in\nPrEP stigma">
				<dimensions>
					<dim name="BxPrEPsubpops"/>
				</dimensions>
				<eqn>&quot;PrEP_Approved_(July_15,_2012)&quot;*(Expected_level_of_stigma-Stigma_associated_with_PrEP_users)/Time_to_change_PrEP_stigma</eqn>
				<units>Stigma units/Month</units>
			</flow>
			<aux name="HIV prev rate per\ngroup per 100K">
				<dimensions>
					<dim name="BxPrEPsubpops"/>
				</dimensions>
				<eqn>Bronx_HIV_care_population/(Bronx_target_population*Initial_prop_subpop)*100000</eqn>
				<units>Person/Person</units>
			</aux>
			<aux name="HIV incidence rate\nper group per 100K">
				<dimensions>
					<dim name="BxPrEPsubpops"/>
				</dimensions>
				<eqn>HIV_incidence/(Bronx_target_population*Initial_prop_subpop)*100000</eqn>
				<units>Persons/Person/Month</units>
			</aux>
		</variables>
