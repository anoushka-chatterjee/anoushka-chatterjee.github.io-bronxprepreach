				<text_box font_weight="bold" text_align="center" vertical_text_align="center" font_size="24pt" appearance="transparent" x="37.1507" y="10.5" width="652.654" height="48">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
