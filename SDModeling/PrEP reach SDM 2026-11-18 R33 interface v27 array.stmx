					<eqn>PrEP_seekers*Per_contact_risk_of_infection[BxPrEPsubpops]*Contacts_per_susceptible_per_month[BxPrEPsubpops]</eqn>
				</element>
				<element subscript="Bronx">
					<eqn>PrEP_seekers*Per_contact_risk_of_infection[BxPrEPsubpops]*Contacts_per_susceptible_per_month[BxPrEPsubpops]</eqn>
				</element>
				<non_negative/>
				<units>Persons/Month</units>
			</flow>
			<flow name="HIV test pos\nrate quitters">
				<dimensions>
					<dim name="BxPrEPsubpops"/>
				</dimensions>
				<eqn>PrEP_quitters*Contacts_per_susceptible_per_month*Per_contact_risk_of_infection</eqn>
				<non_negative/>
				<units>Persons/Month</units>
			</flow>
			<aux name="Expected\nintervention\neffect size\nPrEP ACCESS &amp;\nENGAGEMENT">
