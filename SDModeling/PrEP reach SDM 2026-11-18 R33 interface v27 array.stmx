			<aux name="PrEP Approved\n(July 15, 2012)">
				<eqn>IF (TIME&gt;30) THEN 1 ELSE 0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="PrEP OUTREACH\n&amp; AWARENESS">
				<eqn>IF (TIME &gt; 202) THEN &quot;Expected_intervention_effect_size_PrEP_OUTREACH_&amp;_AWARENESS&quot; ELSE 1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="PrEP ACCESS &amp;\nENGAGEMENT">
				<eqn>IF (TIME &gt; 202) THEN &quot;Expected_intervention_effect_size_PrEP_ACCESS_&amp;_ENGAGEMENT&quot; ELSE 1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="PrEP RETENTION">
				<eqn>IF (TIME &gt; 202) THEN Expected_intervention_effect_size_PrEP_RETENTION ELSE 1</eqn>
				<units>dmnl</units>
			</aux>
			<flow name="HIV test pos\nrate seekers">
				<dimensions>
					<dim name="BxPrEPsubpops"/>
				</dimensions>
				<element subscript="Cisgender_women">
					<eqn>PrEP_seekers*Per_contact_risk_of_infection[BxPrEPsubpops]*Contacts_per_susceptible_per_month[BxPrEPsubpops]</eqn>
				</element>
				<element subscript="Trans_women">
					<eqn>PrEP_seekers*Per_contact_risk_of_infection[BxPrEPsubpops]*Contacts_per_susceptible_per_month[BxPrEPsubpops]</eqn>
